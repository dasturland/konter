{
  "name": "kontr-strayk-3d",
  "version": "1.0.0",
  "private": true,
  "description": "KONTR-STRAYK 3D: first-person shooter with bots and online multiplayer",
  "type": "module",
  "license": "MIT",
  "workspaces": ["client", "server", "shared"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "start": "npm run build && node server/src/index.js",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
